{
  "name": "lineage",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "start": "tsx src/server/index.ts",
    "build": "npm run build:capture && npm run build:web",
    "build:web": "vite build --config vite.config.ts",
    "build:capture": "node scripts/build-capture.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:compatibility": "vitest run tests/unit/domain",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "verify:parity": "node scripts/verify-parity.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.10.0",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  }
}
