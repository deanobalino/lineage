{
  "name": "lineage",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build:capture": "node scripts/build-capture.mjs",
    "test": "vitest run",
    "test:compatibility": "vitest run tests/unit/domain",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "verify:parity": "node scripts/verify-parity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.10.0"
  }
}
